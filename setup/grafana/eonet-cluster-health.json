    {
      "id": 8,
      "type": "timeseries",
      "title": "Disk I/O Throughput by Node (MB/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "cg4u5v0cwamf4e"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cg4u5v0cwamf4e"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total[2m]) + rate(node_disk_written_bytes_total[2m])) / 1048576",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{instance}}",
