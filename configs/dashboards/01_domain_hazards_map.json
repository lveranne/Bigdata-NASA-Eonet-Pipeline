      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (p.event_id) p.event_id, e.title, p.category_id, p.pred_severity_tier AS severity_tier, ROUND(p.elapsed_hours::numeric, 1) AS elapsed_h, ROUND(p.pred_duration_hours::numeric, 1) AS pred_total_h, ROUND(p.pred_remaining_hours::numeric, 1) AS remaining_h, ROUND(e.temp_2m_c::numeric, 1) AS temp_c, ROUND(e.humidity_2m_pct::numeric, 0) AS humidity_pct, ROUND(e.wind_10m_ms::numeric, 1) AS wind_ms FROM eonet_predictions p JOIN eonet_events_stream e ON p.event_id = e.event_id WHERE p.status = 'open' AND p.model_version = 'v3_xgboost' ORDER BY p.event_id, p.predicted_at_utc DESC;",
          "refId": "A"
        }
