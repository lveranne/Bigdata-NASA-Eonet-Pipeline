      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (p.event_id) p.event_id, e.title, p.category_id, e.latitude, e.longitude, p.pred_severity_tier AS severity_tier, ROUND(p.pred_duration_hours::numeric, 1) AS pred_total_h, ROUND(p.pred_remaining_hours::numeric, 1) AS remaining_h, ROUND(e.temp_2m_c::numeric, 1) AS temp_c, ROUND(e.wind_10m_ms::numeric, 1) AS wind_ms FROM eonet_predictions p JOIN eonet_events_stream e ON p.event_id = e.event_id WHERE p.status = 'open' AND p.model_version = 'v3_xgboost' AND e.latitude IS NOT NULL AND e.longitude IS NOT NULL ORDER BY p.event_id, p.predicted_at_utc DESC;",
          "refId": "A"
        }
      ],
      "title": "Global Active Hazards Map (Color & Size = Severity Tier)",
      "type": "geomap"
