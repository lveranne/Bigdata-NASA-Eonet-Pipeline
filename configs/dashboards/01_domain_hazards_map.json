          "rawSql": "SELECT ROUND(AVG(pred_remaining_hours)::numeric, 1) AS avg_remaining_h FROM (SELECT DISTINCT ON (event_id) pred_remaining_hours FROM eonet_predictions WHERE status = 'open' AND model_version = 'v3_xgboost' ORDER BY event_id, predicted_at_utc DESC) s;",
