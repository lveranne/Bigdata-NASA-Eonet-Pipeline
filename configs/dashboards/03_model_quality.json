      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ag5ljhsr3kzk0b"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH roles AS (SELECT model_version, UPPER(deployment_role) AS role FROM eonet_model_registry), latest_stream AS (SELECT DISTINCT ON (event_id) event_id, status, ingested_at_utc FROM eonet_events_stream ORDER BY event_id, ingested_at_utc DESC), latest_preds AS (SELECT DISTINCT ON (event_id, model_version) event_id, model_version, elapsed_hours, pred_duration_hours FROM eonet_predictions ORDER BY event_id, model_version, predicted_at_utc DESC), eval_cohort AS (  SELECT s.event_id,     CASE WHEN s.status = 'closed' THEN MAX(p.elapsed_hours)          ELSE GREATEST(MAX(p.elapsed_hours), PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.pred_duration_hours)) END AS target_h,     MAX(CASE WHEN p.model_version = 'v1_baseline' THEN p.pred_duration_hours END) AS p1,     MAX(CASE WHEN p.model_version = 'v2_gbt' THEN p.pred_duration_hours END) AS p2,     MAX(CASE WHEN p.model_version = 'v3_xgboost' THEN p.pred_duration_hours END) AS p3   FROM latest_stream s JOIN latest_preds p ON s.event_id = p.event_id GROUP BY s.event_id, s.status), winners AS (  SELECT CASE     WHEN ABS(p3 - target_h) < ABS(p2 - target_h) AND ABS(p3 - target_h) < ABS(p1 - target_h) THEN 'v3_xgboost'     WHEN ABS(p2 - target_h) < ABS(p3 - target_h) AND ABS(p2 - target_h) < ABS(p1 - target_h) THEN 'v2_gbt'     WHEN ABS(p1 - target_h) < ABS(p2 - target_h) AND ABS(p1 - target_h) < ABS(p3 - target_h) THEN 'v1_baseline'     ELSE 'Tie' END AS model_key   FROM eval_cohort WHERE p1 IS NOT NULL AND p2 IS NOT NULL AND p3 IS NOT NULL) SELECT COALESCE(w.model_key || ' (' || r.role || ')', 'Tie') AS winner, COUNT(*) AS wins FROM winners w LEFT JOIN roles r ON w.model_key = r.model_version GROUP BY 1 ORDER BY 2 DESC;",
          "refId": "A"
        }
      ],
      "title": "Live Stream Prediction Win Rate (Champion vs. Shadows)",
      "type": "piechart"
    },
