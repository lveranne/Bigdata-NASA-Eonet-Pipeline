      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ag5ljhsr3kzk0b"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n                      category_id,\n                      ROUND(AVG(actual_duration_hours)::numeric, 1) AS \"Actual Duration (h)\",\n                      ROUND(AVG(CASE WHEN model_version = 'v1_baseline' THEN pred_duration_hours END)::numeric, 1) AS \"v1 Predicted (h) - Baseline\",\n                      ROUND(AVG(CASE WHEN model_version = 'v2_gbt' THEN pred_duration_hours END)::numeric, 1) AS \"v2 Predicted (h) - GBT\",\n                      ROUND(AVG(CASE WHEN model_version = 'v3_xgboost' THEN pred_duration_hours END)::numeric, 1) AS \"v3 Predicted (h) - XGBoost\"\n                    FROM eonet_prediction_history\n                    WHERE status = 'closed' AND actual_duration_hours IS NOT NULL\n                    GROUP BY 1\n                    ORDER BY COUNT(*) DESC\n                    LIMIT 6;",
          "refId": "A"
