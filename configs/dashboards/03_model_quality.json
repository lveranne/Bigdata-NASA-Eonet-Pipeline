      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ag5ljhsr3kzk0b"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH champ AS (SELECT model_version FROM eonet_model_registry WHERE deployment_role = 'champion' LIMIT 1), latest_stream AS (SELECT DISTINCT ON (event_id) event_id, title, category_id, status, event_time_utc, closed_time_utc, ingested_at_utc FROM eonet_events_stream ORDER BY event_id, ingested_at_utc DESC), latest_preds AS (SELECT DISTINCT ON (event_id, model_version) event_id, model_version, elapsed_hours, pred_duration_hours, pred_severity_tier FROM eonet_predictions ORDER BY event_id, model_version, predicted_at_utc DESC), pivoted AS (  SELECT s.event_id, s.title, s.category_id, s.status, s.event_time_utc, s.closed_time_utc,     MAX(p.elapsed_hours) AS elapsed_hours, MAX(p.pred_severity_tier) AS severity_tier,     MAX(CASE WHEN p.model_version = 'v1_baseline' THEN p.pred_duration_hours END) AS v1_pred,     MAX(CASE WHEN p.model_version = 'v2_gbt' THEN p.pred_duration_hours END) AS v2_pred,     MAX(CASE WHEN p.model_version = 'v3_xgboost' THEN p.pred_duration_hours END) AS v3_pred,     MAX(CASE WHEN p.model_version = (SELECT model_version FROM champ) THEN p.pred_duration_hours END) AS champ_pred   FROM latest_stream s JOIN latest_preds p ON s.event_id = p.event_id   GROUP BY s.event_id, s.title, s.category_id, s.status, s.event_time_utc, s.closed_time_utc) SELECT event_id AS \"Event ID\", title AS \"Hazard Title\", category_id AS \"Category\", status AS \"Status\", severity_tier AS \"Severity Tier\", event_time_utc AS \"Opened (UTC)\", COALESCE(closed_time_utc::text, 'Pending (Open)') AS \"Actual Close (UTC)\", CASE WHEN status = 'closed' THEN ROUND(elapsed_hours::numeric, 1) ELSE NULL END AS \"Actual Dur (h)\", ROUND(v1_pred::numeric, 1) AS \"v1 Pred (h)\", CASE WHEN status = 'closed' THEN ROUND((v1_pred - elapsed_hours)::numeric, 2) ELSE NULL END AS \"v1 Error (h)\", ROUND(v2_pred::numeric, 1) AS \"v2 Pred (h)\", CASE WHEN status = 'closed' THEN ROUND((v2_pred - elapsed_hours)::numeric, 2) ELSE NULL END AS \"v2 Error (h)\", ROUND(v3_pred::numeric, 1) AS \"v3 Pred (h)\", CASE WHEN status = 'closed' THEN ROUND((v3_pred - elapsed_hours)::numeric, 2) ELSE NULL END AS \"v3 Error (h)\", CASE WHEN status = 'open' THEN (SELECT model_version || ' (CHAMPION)' FROM champ)      WHEN ABS(v3_pred - elapsed_hours) <= LEAST(ABS(v1_pred - elapsed_hours), ABS(v2_pred - elapsed_hours)) THEN 'v3_xgboost'      WHEN ABS(v2_pred - elapsed_hours) < ABS(v1_pred - elapsed_hours) THEN 'v2_gbt'      ELSE 'v1_baseline' END AS \"Best / Active Model\", event_time_utc + (CASE WHEN status = 'open' THEN champ_pred ELSE LEAST(v1_pred, v2_pred, v3_pred) END * INTERVAL '1 hour') AS \"Predicted Close (UTC)\" FROM pivoted ORDER BY event_time_utc DESC;",
          "refId": "A"
        }
      ],
      "title": "Stream Events Lifecycle Forecast: Active Champion Close vs. Shadow Benchmark Errors",
      "type": "table"
    }
