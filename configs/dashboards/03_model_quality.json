          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily_mae AS (\n                      SELECT\n                        time_bucket('1 day', scored_at_utc) AS day_ts,\n                        model_version,\n                        AVG(abs_error_hours) AS daily_mae_h\n                      FROM eonet_prediction_history\n                      WHERE actual_duration_hours IS NOT NULL\n                        AND $__timeFilter(scored_at_utc)\n                      GROUP BY 1, 2\n                    )\n                    SELECT\n                      day_ts AS time,\n                      model_version AS series,\n                      ROUND(\n                        AVG(daily_mae_h) OVER (\n                          PARTITION BY model_version\n                          ORDER BY day_ts\n                          ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n                        )::numeric,\n                        2\n                      ) AS rolling_mae_hours\n                    FROM daily_mae\n                    ORDER BY 1 ASC, 2 ASC;",
          "refId": "A"
        }
      ],
      "title": "Continuous 7-Day Rolling MAE Evolution Across Regime Cutoff (v2 GBT vs. v3 XGBoost Crossover)",
      "type": "timeseries"
