        "name": "Train / Test Split",
        "rawQuery": "SELECT event_ts AS time, 'TRAIN / TEST SPLIT (' || component || ')' AS title, COALESCE(details::text, model_version) AS text FROM eonet_lifecycle_events WHERE event_type IN ('train_test_cutoff', 'temporal_train_test_split') AND $__timeFilter(event_ts) ORDER BY event_ts;",
        "showIn": 0
      }
    ]
  },
